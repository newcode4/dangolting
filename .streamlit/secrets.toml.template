# 이 파일을 복사하여 .streamlit/secrets.toml 로 저장 후 실제 값을 채우세요.
# ⚠️ secrets.toml.template 은 Streamlit이 읽지 않습니다 — 반드시 secrets.toml 로 복사!
# secrets.toml은 절대 git에 커밋하지 마세요!

[gcp_service_account]
type                        = "service_account"
project_id                  = "your-project-id"
private_key_id              = "your-key-id"
private_key                 = "-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
client_email                = "your-service-account@your-project.iam.gserviceaccount.com"
client_id                   = "123456789"
auth_uri                    = "https://accounts.google.com/o/oauth2/auth"
token_uri                   = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url        = "https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-project.iam.gserviceaccount.com"

# ── 공개 앱 URL (Kakao OG 썸네일 절대 경로 — 배포 후 본인 앱 주소로 설정) ──
[app]
public_url = "https://dangolting-fusxuqj52c7scbvcuduiej.streamlit.app"

# ── 관리자 로그인 (필수) ──
[auth]
session_key = "change-me-to-random-32chars-or-more"

# 공개 회원가입 — 기본 false (관리자만 접근)
allow_signup = false
# 관리자 전용 URL 경로 — https://your-app/?p=아래값 (공개 랜딩에 링크 없음)
admin_path = ""
# allow_signup = true 로 켤 때만 사용 — 팀원 추가용 초대 코드
# signup_code = "your-invite-code-here"

# 최초 관리자 (secrets 또는 users.json 없을 때)
bootstrap_user = "admin"
bootstrap_password = "changeme"

# 배포(HTTPS)에서 자동 로그인 쿠키 유지 — Streamlit Cloud 등
cookie_secure = true
# [auth.users.admin]
# password = "your-secure-password"
# [auth.users.manager]
# password = "another-secure-password"

# ── 텔레그램 신규 신청 알림 (선택) ──
# BotFather에서 봇 생성 → token, chat_id 입력
# chat_id: @userinfobot 에게 /start 하면 확인
[telegram]
bot_token = "123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
chat_id = "123456789"
enabled = false
poll_seconds = 120
